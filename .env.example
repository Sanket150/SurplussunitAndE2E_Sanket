SES_FROM_EMAIL=
SES_TEAM_EMAIL=
WATI_API_URL=
WATI_API_TOKEN=
WATI_ENQUIRY_TEMPLATE=surpluss_catalog_template
WATI_TEAM_NUMBER=
WATI_WHATSAPP_NUMBER=
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=
NEXT_PUBLIC_GTM_ID=
