# Copy to .env for local development. Never commit .env or real credentials.
NEXTAUTH_URL=http://localhost:3001
APP_URL=http://localhost:3001
AUTH_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://catalogue:catalogue@localhost:5544/catalogue?schema=public
DIRECT_URL=postgresql://catalogue:catalogue@localhost:5544/catalogue?schema=public

# Optional integrations. Leave blank when not configured.
